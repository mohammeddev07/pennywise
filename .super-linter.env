# Super-Linter Configuration
LOG_LEVEL=NOTICE

# CHECKOV - Infrastructure as Code security scanning
# Skip validation since we're not using IaC files
VALIDATE_CHECKOV=false

# JSCPD - Duplicate code detection
# Skip validation for now to focus on code quality
VALIDATE_JSCPD=false

# YAML Prettier - YAML formatting
VALIDATE_YAML_PRETTIER=true
YAML_CONFIG_FILE=.prettierrc.yaml

# Java - use the same Google style for formatting and Checkstyle
JAVA_FILE_NAME=google_checks.xml

# SQL - parse Flyway migrations as PostgreSQL
SQLFLUFF_CONFIG_FILE=.sqlfluff

# Disable unnecessary linters for Java/Kotlin backend
VALIDATE_CLOJURE=false
VALIDATE_COFFEESCRIPT=false
VALIDATE_CSHARP=false
VALIDATE_ENV=false
VALIDATE_GHERKIN=false
VALIDATE_JAVASCRIPT_PRETTIER=false
VALIDATE_JSONNET=false
VALIDATE_KOTLIN=false
VALIDATE_LUA=false
VALIDATE_PERL=false
VALIDATE_PHP=false
VALIDATE_POWERSHELL=false
VALIDATE_PROTOBUF=false
VALIDATE_RUBY=false
VALIDATE_RUST=false
VALIDATE_SCALAFMT=false
VALIDATE_SHELL_SHFMT=false
VALIDATE_SNAKEMAKE=false
VALIDATE_SWIFT=false
VALIDATE_TERRAFORM=false
VALIDATE_TYPESCRIPT_PRETTIER=false
